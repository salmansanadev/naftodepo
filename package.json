{
  "name": "naftodepo",
  "version": "0.1.0",
  "description": "Offline fuel inventory and driver ledger for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "keywords": [],
  "author": "Salman Sana",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "build": {
    "appId": "pk.naftodepo.desktop",
    "productName": "Nafto Depo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
